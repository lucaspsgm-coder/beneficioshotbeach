# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Banco (usado só pelo npm run db:setup). No Supabase: botão Connect → Session pooler → URI.
# Troque [YOUR-PASSWORD] pela senha do banco definida ao criar o projeto.
DATABASE_URL=

# Só no servidor: usada para criar usuários e redefinir senhas
SUPABASE_SERVICE_ROLE_KEY=

# O login é por usuário (ex.: lucas.pereira). Internamente vira usuario@DOMINIO.
AUTH_EMAIL_DOMAIN=central-beneficios.local

# Administrador inicial (usado só pelo npm run seed:admin)
ADMIN_USERNAME=lucas.pereira
ADMIN_FULL_NAME=Lucas Pereira
ADMIN_PASSWORD=
